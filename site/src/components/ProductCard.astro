---
import type { Product } from "../data/products.ts";
import { u } from "../lib/url.ts";
interface Props {
  product: Product;
  index: string;
  category: string;
}
const { product, index, category } = Astro.props;

// Cards used to link out to the Shopify storefront. That store is closed
// and every product URL now 404s, so the card opens a detail view in
// place instead — see FlipLightbox, which reads the data-flip-* below.
const status = product.soldOut
  ? "sold out"
  : product.lowStock
    ? `${product.lowStock} left`
    : "available";
const state = product.soldOut ? "sold-out" : product.lowStock ? "low" : "in-stock";
---
<article
  class:list={[
    "misc__card",
    product.soldOut && "misc__card--sold-out",
  ]}
  data-slug={product.slug}
  data-category={category}
  data-flip-mode="card"
  data-flip-index={index}
  data-flip-title={product.title}
  data-flip-price={`$${product.price.toFixed(2)}`}
  data-flip-category={category}
  data-flip-status={status}
  data-flip-state={state}
>
  <span class="misc__card-num" aria-hidden="true">{index}</span>
  <div class="misc__link">
    <div class="misc__media">
      {product.soldOut && (
        <span class="misc__sold-out" aria-label="Sold out">sold out</span>
      )}
      {!product.soldOut && product.lowStock && (
        <span class="misc__low-stock" aria-label={`Only ${product.lowStock} left`}>{product.lowStock} left</span>
      )}
      <div class="misc__float">
        <img class="misc__img" src={u(product.image)} alt={product.title} loading="lazy" />
      </div>
    </div>
    <div class="misc__meta">
      <span class="misc__name">{product.title}</span>
      <span class="misc__price">${product.price.toFixed(2)}</span>
    </div>
  </div>
</article>
