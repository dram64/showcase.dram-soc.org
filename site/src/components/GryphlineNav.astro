---
import { u } from "../lib/url.ts";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/work",         label: "work" },
  { href: "/process",      label: "process" },
  { href: "/architecture", label: "arch" },
  { href: "/status",       label: "status" },
  { href: "/insights",     label: "insights" },
  { href: "/contact",      label: "contact" },
];
---
<nav class="gl-nav" role="navigation" aria-label="Primary">
  <a class="gl-nav__brand" href={u("/")}>
    <span class="gl-nav__brand-mark" aria-hidden="true"></span>
    dram-soc.<em>ops</em>
  </a>
  <div class="gl-nav__links">
    {links.map(l => <a href={u(l.href)} aria-current={path === u(l.href) ? "page" : undefined}>{l.label}</a>)}
  </div>
</nav>
